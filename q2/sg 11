class HealthPotion:
    def use(self):
        print("You regain 50 HP!")


class ManaPotion:
    def use(self):
        print("You restore 30 MP!")


class SpeedBoost:
    def use(self):
        print("Your speed increases for 10 seconds!")


def apply_item(item):
    item.use()


# Creating objects
health = HealthPotion()
mana = ManaPotion()
speed = SpeedBoost()

# Storing objects in a list
potions = [health, mana, speed]

# Calling apply_item() using a loop
for potion in potions:
    apply_item(potion)

