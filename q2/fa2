
class Patient:
    def __init__(self, name, bill_amount):
        self.__name = name
        self.__bill_amount = bill_amount

    def get_name(self):
        return self.__name

    def get_bill_amount(self):
        return self.__bill_amount

    def set_name(self, name):
        self.__name = name

    def set_bill_amount(self, bill_amount):
        self.__bill_amount = bill_amount

    def calculate_bill(self):
        return self.__bill_amount


class SeniorPatient(Patient):
    def calculate_bill(self):
        return self.get_bill_amount() * 0.80


class PhilHealthPatient(Patient):
    def calculate_bill(self):
        return self.get_bill_amount() * 0.85


regular_patient = Patient("Juan Dela Cruz", 15000)
senior_patient = SeniorPatient("Maria Santos", 15000)
philhealth_patient = PhilHealthPatient("Pedro Reyes", 15000)


print("=== HOSPITAL BILLING SYSTEM ===")

print("\nRegular Patient")
print("Name:", regular_patient.get_name())
print("Original Bill: ₱", regular_patient.get_bill_amount())
print("Final Bill: ₱", regular_patient.calculate_bill())

print("\nSenior Patient")
print("Name:", senior_patient.get_name())
print("Original Bill: ₱", senior_patient.get_bill_amount())
print("Final Bill: ₱", senior_patient.calculate_bill())

print("\nPhilHealth Patient")
print("Name:", philhealth_patient.get_name())
print("Original Bill: ₱", philhealth_patient.get_bill_amount())
print("Final Bill: ₱", philhealth_patient.calculate_bill())
