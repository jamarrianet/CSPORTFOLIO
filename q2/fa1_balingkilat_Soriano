class Publication:
    def __init__(self, title, author):
        self.__title = title
        self.__author = author

    def set_title(self, title):
        self.__title = title

    def get_title(self):
        return self.__title

    def set_author(self, author):
        self.__author = author

    def get_author(self):
        return self.__author

    def display_info(self):
        print("Title : ", self.get_title())
        print("Author : ", self.get_author())


class Book(Publication):
    def __init__(self, title, author, number_pages):
        super().__init__(title, author)
        self.__number_pages = None
        self.set_number_of_pages(number_pages)

    def get_number_of_pages(self):
        return self.__number_pages

    def set_number_of_pages(self, number_pages):
        if number_pages > 0:
            self.__number_pages = number_pages
        else:
            print("Number of pages must be positive.")

    def display_info(self):
        print("Title : ", self.get_title())
        print("Author : ", self.get_author())
        print("Pages: ", self.get_number_of_pages())


class Magazine(Publication):
    def __init__(self, title, author, issue_number):
        super().__init__(title, author)
        self.__issue_number = None
        self.set_issue_number(issue_number)

    def get_issue_number(self):
        return self.__issue_number

    def set_issue_number(self, issue_number):
        if issue_number > 0:
            self.__issue_number = issue_number
        else:
            print("Issue number must be positive.")

    def display_info(self):
        print("Title : ", self.get_title())
        print("Author : ", self.get_author())
        print("Issue Number : ", self.get_issue_number())


# Objects
pub1 = Publication("Journal of Experimental Psychology", "Ratchiff, R. & Vann Dongen, H.")
