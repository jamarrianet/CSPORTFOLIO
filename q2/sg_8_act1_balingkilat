class Hooman:
    __name = 'Audrey'; __age = 15; __birthday = "September 2 2011"
    
    def set_name(self,value):
        self.__name = value
    def get_name(self):
        return f"I am {self.__name}"
    
    def set_age(self,value):
        if value > 0:
            self.__age = value
    def get_age(self):
        return f"I am {self.__age} years old."
        
    @property
    def name(self):
        return f"I am {self.__name}"
        
    @property
    def age(self):
        return f"I am {self.__age} years old."
    
    @name.setter
    def name(self, value):
        self.__name = value
    
    @age.setter
    def age(self, value):
        if value > 0:
            self.__age = value

